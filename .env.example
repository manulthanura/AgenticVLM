# Resource root only, e.g. https://<name>.openai.azure.com (no /openai/v1 suffix: the SDK adds the path)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# An API version such as 2025-04-01-preview, not a model version such as 2025-08-07
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_FAST=
AZURE_OPENAI_DEPLOYMENT_STRONG=
DATA_DIR=data
OUTPUTS_DIR=outputs
POSE_MODEL=yolo26s-pose.pt
SAMPLE_FPS=5
DETECTION_CONF_MIN=0.25
KEYPOINT_CONF_MIN=0.3
EDGE_MARGIN_PX=30
RELOCK_MAX_DIST_BBOX_HEIGHTS=1.5
MIN_STATE_DWELL_SEC=2
DWELL_SHARE_MIN=0.7
STATE_CONFIDENCE_MIN=0.5
VISIBLE_RATIO_MIN=0.4
LYING_TORSO_ANGLE_DEG=60
SEATED_KNEE_MAX_DEG=145
WALKING_SPEED_MIN=0.3
BED_EXIT_CONFIRM_SEC=5
BED_RETURN_CONFIRM_SEC=5
EDGE_SITTING_MONITOR_SEC=180
UNKNOWN_MONITOR_SEC=30
OUT_OF_BED_ALERT_SEC=600
OUT_OF_VIEW_ALERT_SEC=300
UNKNOWN_ESCALATE_SEC=10
AGENT_MIN_CONFIDENCE=0.6
AGENT_CONTEXT_SEC=10
AGENT_FRAMES_PER_CALL=4
AGENT_IMAGE_MAX_SIDE=512
MULTIPLE_PERSONS_MIN_SEC=3
AGENT_MAX_STEPS=4
AGENT_MAX_CALLS_PER_VIDEO=30
EVENT_MATCH_TOLERANCE_SEC=5
EVALUATION_SAMPLE_SEC=1
FAILURE_CASES_MAX=5
